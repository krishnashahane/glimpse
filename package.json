{
  "name": "glimpse",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "db:push": "pnpm --filter api db:push",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "db:studio": "pnpm --filter api db:studio",
    "typecheck": "pnpm --filter api typecheck && pnpm --filter web typecheck",
    "check": "pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "packageManager": "pnpm@10.18.3"
}
